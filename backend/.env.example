# SpecSentinel Backend Configuration

# Environment (dev/staging/prod)
ENV=dev
DEBUG=true

# Database (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://specsentinel:specsentinel@localhost:5432/specsentinel

# Security
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=50

# Stripe (TODO: Add real keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxx
USE_LLM_EXTRACTION=true
